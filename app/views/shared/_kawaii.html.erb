<%# Mascota kawaii ORIGINAL (no es Pikachu): se asoma y se agarra del borde. %>
<svg class="kawaii" viewBox="2 2 44 41" role="img" aria-label="mascota" xmlns="http://www.w3.org/2000/svg">
  <!-- orejitas -->
  <ellipse cx="16" cy="9" rx="3.2" ry="5" fill="#f4d35e" stroke="#d9b441" stroke-width="1.2" transform="rotate(-18 16 9)"/>
  <ellipse cx="32" cy="9" rx="3.2" ry="5" fill="#f4d35e" stroke="#d9b441" stroke-width="1.2" transform="rotate(18 32 9)"/>
  <!-- cabeza/cuerpo -->
  <circle cx="24" cy="23" r="13" fill="#f4d35e" stroke="#d9b441" stroke-width="1.5"/>
  <!-- mejillas -->
  <circle cx="14.5" cy="26" r="2.8" fill="#f08a8a" opacity=".85"/>
  <circle cx="33.5" cy="26" r="2.8" fill="#f08a8a" opacity=".85"/>
  <!-- ojos -->
  <circle cx="19.5" cy="21.5" r="2.2" fill="#3a3326"/>
  <circle cx="28.5" cy="21.5" r="2.2" fill="#3a3326"/>
  <circle cx="20.3" cy="20.8" r=".6" fill="#fff"/>
  <circle cx="29.3" cy="20.8" r=".6" fill="#fff"/>
  <!-- sonrisa -->
  <path d="M21 27 q3 2.6 6 0" fill="none" stroke="#3a3326" stroke-width="1.3" stroke-linecap="round"/>
  <!-- chispa -->
  <path d="M37 4 l-4 6 h3 l-3 5 6.5-7 h-3.2 z" fill="#e0a23c" stroke="#c98a2c" stroke-width=".6" stroke-linejoin="round"/>
  <!-- (sin línea: el borde del box de la notificación hace de barra) -->
  <!-- patita izquierda -->
  <rect x="11" y="34" width="8" height="6" rx="3" fill="#f4d35e" stroke="#d9b441" stroke-width="1"/>
  <circle cx="12.6" cy="40.2" r="1.2" fill="#f4d35e" stroke="#d9b441" stroke-width=".7"/>
  <circle cx="15"   cy="40.6" r="1.2" fill="#f4d35e" stroke="#d9b441" stroke-width=".7"/>
  <circle cx="17.4" cy="40.2" r="1.2" fill="#f4d35e" stroke="#d9b441" stroke-width=".7"/>
  <!-- patita derecha -->
  <rect x="29" y="34" width="8" height="6" rx="3" fill="#f4d35e" stroke="#d9b441" stroke-width="1"/>
  <circle cx="30.6" cy="40.2" r="1.2" fill="#f4d35e" stroke="#d9b441" stroke-width=".7"/>
  <circle cx="33"   cy="40.6" r="1.2" fill="#f4d35e" stroke="#d9b441" stroke-width=".7"/>
  <circle cx="35.4" cy="40.2" r="1.2" fill="#f4d35e" stroke="#d9b441" stroke-width=".7"/>
</svg>
