<div class="card auth">
  <div class="lbl"><%= t(".title") %> <span class="kr">인증</span></div>
  <p class="hint" style="margin-bottom:14px"><%= t(".hint") %></p>
  <%= form_with url: login_code_path, method: :post, data: { controller: "otp" } do %>
    <%= hidden_field_tag :email, @email %>
    <%= text_field_tag :code, nil, placeholder: "______", required: true, autofocus: true,
          inputmode: "numeric", pattern: "[0-9]*", maxlength: 6, autocomplete: "one-time-code",
          class: "mono", style: "font-size:22px;letter-spacing:8px;text-align:center",
          data: { "otp-target": "input", action: "input->otp#check" } %>
    <%= submit_tag t(".verify"), class: "btn addbtn", style: "margin-top:10px" %>
  <% end %>
  <p class="hint" style="margin-top:12px"><%= link_to t(".another_link"), login_path %></p>
</div>
