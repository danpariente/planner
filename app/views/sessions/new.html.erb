<div class="card auth">
  <div class="lbl"><%= t(".title") %> <span class="kr">로그인</span></div>
  <p class="hint" style="margin-bottom:14px"><%= t(".hint") %></p>
  <%= form_with url: login_path, method: :post do %>
    <%= email_field_tag :email, params[:email], placeholder: t(".email_placeholder"), required: true, autofocus: true, autocomplete: "email" %>
    <%= submit_tag t(".send_link"), class: "btn addbtn", style: "margin-top:10px" %>
  <% end %>
  <p class="hint" style="margin-top:12px"><%= locale_toggle("") %></p>
</div>
