<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Planner · 플래너</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# PWA (instalable) %>
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <meta name="theme-color" content="#f7f8fa">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Planner">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="apple-touch-icon" href="<%= asset_path("icon-192.png") %>">
    <link rel="icon" href="<%= asset_path("icon-192.png") %>" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="brand"><h1>PLANNER</h1><span class="kr">플래너</span></div>
      </header>
      <% if flash[:welcome] %>
        <div class="flash welcome" data-controller="flash" data-flash-delay-value="5000">
          <%= image_tag "star.png", class: "kawaii", alt: "estrella" %>
          <span class="welcome-text"><%= flash[:welcome] %></span>
        </div>
      <% end %>
      <% if notice %><div class="flash notice" data-controller="flash"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert" data-controller="flash"><%= alert %></div><% end %>
      <%= render "shared/nav" if current_account %>
      <%= yield %>
    </div>
  </body>
</html>
