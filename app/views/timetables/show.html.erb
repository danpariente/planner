<div class="card">
  <div class="lbl"><%= t(".title") %> <span class="kr">시간표</span></div>
  <div class="wgrid">
    <%# Una <form> por celda: solo se envía la celda editada (antes el grid
        entero hacía upsert de las 55 celdas en cada pulsación). %>
    <table>
      <thead>
        <tr>
          <th class="tcol"><%= t(".hour") %></th>
          <% t(".cols").each do |c| %><th><%= c %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% TimetableCell::ROWS.each do |r| %>
          <tr>
            <td class="tcol"><%= r %></td>
            <% TimetableCell::COLS.each_index do |c| %>
              <td>
                <%= form_with url: timetable_path, method: :patch,
                              data: { controller: "autosubmit", action: "input->autosubmit#submit" } do %>
                  <input type="text" name="cells[<%= r %>-<%= c %>]" value="<%= @grid[r][c] %>">
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="hint"><%= t(".hint") %></div>
</div>
