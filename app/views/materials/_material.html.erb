<div id="<%= dom_id(material) %>" style="border:1px solid var(--line2);border-radius:8px;padding:12px;margin-bottom:10px">
  <%= form_with model: material, method: :patch,
                data: { controller: "autosubmit", action: "input->autosubmit#submit" } do |f| %>
    <div class="row" style="gap:8px">
      <%= f.text_field :title, placeholder: t(".title_placeholder"), class: "grow" %>
    </div>
    <div class="row" style="gap:8px;margin-top:8px">
      <%= f.number_field :done_count,  min: 0, class: "mono", style: "width:70px" %>
      <span class="mono" style="color:var(--muted)">/</span>
      <%= f.number_field :total_count, min: 0, class: "mono", style: "width:70px" %>
      <span class="mono" style="color:var(--muted)"><%= t(".units") %></span>
    </div>
  <% end %>
  <div class="pbar"><i style="width:<%= material.pct %>%"></i></div>
  <div class="ptxt"><%= material.pct %>% · <%= t(".progress", done: material.done_count, total: material.total_count) %></div>
  <%= button_to t(".remove"), material_path(material), method: :delete, class: "del",
                style: "margin-top:6px", form: { data: { turbo_stream: true } } %>
</div>
