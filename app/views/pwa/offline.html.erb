<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t(".title") %></title>
  <style>
    body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;
      background:#f7f8fa;color:#1a2230;font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;text-align:center;padding:24px}
    .box{max-width:340px}
    .star{font-size:56px;line-height:1}
    h1{font-family:ui-monospace,Menlo,monospace;font-size:18px;letter-spacing:.04em;margin:14px 0 6px;color:#0d9488}
    p{color:#5b6677;font-size:14px;line-height:1.5;margin:0 0 18px}
    button{font-family:ui-monospace,Menlo,monospace;font-size:13px;cursor:pointer;border:1px solid #0d9488;
      background:rgba(13,148,136,.10);color:#0d9488;border-radius:8px;padding:9px 18px}
  </style>
</head>
<body>
  <div class="box">
    <div class="star">⭐</div>
    <h1><%= t(".heading") %></h1>
    <p><%= t(".body") %></p>
    <button onclick="location.reload()"><%= t(".retry") %></button>
  </div>
</body>
</html>
