<div class="card">
  <div class="lbl"><%= t(".title") %> <span class="kr">수행평가</span> · <%= t(".subtitle") %></div>
  <table>
    <thead><tr><th class="wcat"><%= t(".col_category") %></th><th><%= t(".col_body") %></th><th class="wdate"><%= t(".col_due") %></th><th class="wchk">✓</th><th class="wdel"></th></tr></thead>
    <tbody id="tasks"><%= render @tasks %></tbody>
  </table>
  <%= button_to t(".add"), tasks_path, class: "btn addbtn", form: { data: { turbo_stream: true } } %>
  <div class="hint"><%= t(".hint") %></div>
</div>
