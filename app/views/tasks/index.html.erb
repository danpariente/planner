<div class="card">
  <div class="lbl">Tareas y entregables <span class="kr">수행평가</span> · con deadline</div>
  <table>
    <thead><tr><th class="wcat">cat · 과목</th><th>contenido · 내용</th><th class="wdate">deadline · 마감일</th><th class="wchk">✓</th><th class="wdel"></th></tr></thead>
    <tbody id="tasks"><%= render @tasks %></tbody>
  </table>
  <%= button_to "+ tarea", tasks_path, class: "btn addbtn", form: { data: { turbo_stream: true } } %>
  <div class="hint">Se listan por deadline más próximo. Marca el ✓ al entregar.</div>
</div>
