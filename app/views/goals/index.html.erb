<div class="card">
  <div class="lbl"><%= t(".title") %> <span class="kr">시험 성적</span> · <%= t(".subtitle") %></div>
  <table>
    <thead><tr><th><%= t(".col_area") %></th><th class="wnum"><%= t(".col_target") %></th><th class="wnum"><%= t(".col_previous") %></th><th class="wnum"><%= t(".col_achieved") %></th><th class="wchk">✓</th><th class="wdel"></th></tr></thead>
    <tbody id="goals"><%= render @goals %></tbody>
  </table>
  <%= button_to t(".add"), goals_path, class: "btn addbtn", form: { data: { turbo_stream: true } } %>
  <div class="hint"><%= t(".hint_html") %></div>
</div>
